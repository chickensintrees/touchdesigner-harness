# TouchDesigner autosaves and backups
Backup/
CrashAutoSave*
*.dmp
*.toe.dir/
*.tox.dir/
# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
# OS
.DS_Store
Thumbs.db
# Per-run captures (hero frames are kept; see td-snapshot)
experiments/*/captures/*
!experiments/*/captures/hero.png
!experiments/*/captures/.gitkeep
# Your local lab project: it contains the MCP server component (TDMCP's license
# forbids redistributing it), so it never goes in git. Experiments are .tox files.
/lab.toe
/lab.*.toe

# Shader Park compiler deps
node_modules/

# FBX COMP import cache
TDImportCache/

# A pack of your own, kept outside the repo: this file names its folder (see assets/README.md).
/assets.local.txt
# Leftover working copies from switching packs (safe to delete).
/assets_generic/
/assets_private_old/
