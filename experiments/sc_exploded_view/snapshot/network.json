  "cam": {
   "type": "cameraCOMP",
   "family": "COMP",
   "pos": [
    -600,
    -150
   ],
   "pars": {
    "far": 40.0,
    "fov": {
     "expr": "op('ctl')['fov']"
    },
    "near": 0.05,
    "orthowidth": 3.5555555555555554,
    "projection": {
     "expr": "'perspective' if op('ctl')['persp'] > 0.5 else 'ortho'"
    },
    "tz": {
     "expr": "op('ctl')['camz']"
    }
   }
  },
