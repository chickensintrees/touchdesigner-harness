  },
  "cook_driver": {
   "type": "executeDAT",
   "family": "DAT",
   "pos": [
    -400,
    -80
   ],
   "pars": {
    "framestart": true,
    "language": "python"
   },
   "text": [
    "def onFrameStart(frame):",
    "    hub = op('/project1/sw_hub')",
    "    me_on = parent().par.Preview.eval()",
    "    if hub is not None:",
    "        me_on = me_on or hub.par.Solo.eval() or hub.par.Scene.eval() == parent().name",
    "    if me_on:",
    "        op('hub').cook(force=True)",
    "        op('out1').cook(force=True)",
    "    return"
   ]
  },
