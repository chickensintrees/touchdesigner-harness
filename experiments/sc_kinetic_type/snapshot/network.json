  "words": {
   "type": "textDAT",
   "family": "DAT",
   "pos": [
    -1500,
    950
   ],
   "pars": {
    "language": "text"
   },
   "text": [
    "{",
    " \"PHRASES\": [",
    "  \"REAL TIME!\",",
    "  \"HERE. NOW. REAL TIME!\",",
    "  \"SIGNAL ACQUIRED...\",",
    "  \"FEEDBACK LOOP ..... OPEN\",",
    "  \"PLATE 07: ORIGIN UNRECORDED.\",",
    "  \"EVERY FRAME IS MADE NOW. THEN GONE.\",",
    "  \"LISTEN WITH YOUR EYES.\",",
    "  \"NOTHING HERE IS PRERENDERED.\",",
    "  \"SOUND IN. PICTURE OUT.\",",
    "  \"THE KICK MOVES THE TYPE.\",",
    "  \"DO NOT TOUCH\",",
    "  \"FOUND, NOT MADE.\",",
    "  \"PLATE 07\",",
    "  \"PLATE 12-B\",",
    "  \"CATALOGUE 0047\",",
    "  \"SIXTY FRAMES A SECOND, EVERY SECOND.\",",
    "  \"THIS PICTURE IS RUNNING IN REAL TIME\",",
