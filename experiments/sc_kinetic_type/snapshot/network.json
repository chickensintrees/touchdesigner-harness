    "vec0name": "uTime",
    "vec0valuew": {
     "expr": "min(op('shot')['age'], absTime.seconds - op('shot0')['sect0'])"
    },
    "vec0valuex": {
     "expr": "op('hub')['beat_pos']"
    },
    "vec0valuey": {
     "expr": "op('hub')['bar_pos']"
    },
    "vec0valuez": {
     "expr": "(lambda b, b0: b - b0 if b >= b0 else b)(op('hub')['beat_pos'], op('shot0')['beat0'])"
    },
    "vec1name": "uHits",
    "vec1valuew": {
     "expr": "op('hub')['pulse']"
    },
    "vec1valuex": {
     "expr": "op('hub')['hit_low']"
    },
    "vec1valuey": {
     "expr": "op('hub')['hit_mid']"
    },
    "vec1valuez": {
     "expr": "op('hub')['hit_high']"
    },
    "vec2name": "uState",
    "vec2valuew": {
     "expr": "(int(op('shot')['take']) % 12)*4 + (int(op('shot')['seed']*4) + int(op('hub')['section'])) % 4"
    },
    "vec2valuex": {
     "expr": "(lambda e: e*e*(3-2*e))(min(1, max(0, (op('hub')['energy']-0.33)/0.32)))"
    },
    "vec2valuey": {
     "expr": "op('hub')['section']"
    },
    "vec2valuez": {
     "expr": "op('shot')['seed']"
    },
    "vec3name": "uCount",
    "vec3valuew": {
     "expr": "op('hub')['t']"
    },
    "vec3valuex": {
     "expr": "op('hub')['bar_i']"
    },
    "vec3valuey": {
     "expr": "op('hub')['beat_i']"
    },
    "vec3valuez": {
     "expr": "op('hub')['hits_low']"
    },
    "vec4name": "uMisc",
    "vec4valuew": {
     "expr": "int(op('shot')['take']) % 12"
    },
    "vec4valuex": {
     "expr": "op('hub')['bar_pulse']"
    },
    "vec4valuey": {
     "expr": "op('hub')['evolve']"
    },
    "vec4valuez": {
     "expr": "op('hub')['hits_high']"
    },
    "vec5name": "uInp",
    "vec5valuew": 0.0,
    "vec5valuex": {
     "expr": "int((lambda o: bool(o) and getattr(o, 'isTOP', False) and not o.path.startswith(parent().path + '/'))(op(parent().par.Input.eval()) if parent().par.Input.eval() else None))"
    },
    "vec5valuey": 0.0,
    "vec5valuez": 0.0
   }
