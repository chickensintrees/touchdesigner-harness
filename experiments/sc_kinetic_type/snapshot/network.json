  "sect_watch": {
   "type": "chopexecuteDAT",
   "family": "DAT",
   "pos": [
    0,
    460
   ],
   "pars": {
    "channel": "section",
    "chop": "hub",
    "language": "python"
   },
   "text": [
    "# Remembers when the musical section last changed while the scene was cooking: arrivals replay on it.",
    "def onValueChange(channel, sampleIndex, val, prev):",
    "    op('shot0').par.value1 = absTime.seconds",
    "    return"
   ]
  },
  "shot": {
   "type": "constantCHOP",
   "family": "CHOP",
   "pos": [
    -400,
    330
   ],
   "pars": {
    "const0name": "take",
    "const0value": {
     "expr": "parent().par.Take"
    },
    "const1name": "seed",
    "const1value": {
     "expr": "parent().par.Seed"
    },
    "const2name": "age",
    "const2value": {
     "expr": "max(0, absTime.seconds - parent().par.Shotstart)"
    }
   }
  },
  "shot0": {
   "type": "constantCHOP",
   "family": "CHOP",
   "pos": [
    -200,
    330
   ],
   "pars": {
    "const0name": "beat0",
    "const0value": 74.0,
    "const1name": "sect0",
    "const1value": 117299.26666666666
   }
  },
  "shot_watch": {
   "type": "parameterexecuteDAT",
   "family": "DAT",
   "pos": [
    -200,
    460
   ],
   "pars": {
    "language": "python",
    "op": "/project1/sc_kinetic_type",
    "pars": "Shotstart Take Seed"
   },
   "text": [
    "# Remembers the beat on which the shot began, so typing and flash cards start with the cut.",
    "def onValueChange(par, prev):",
    "    f = op('/project1/sw_hub/feed')",
    "    try:",
    "        b = float(f['beat_pos'].eval())",
    "    except Exception:",
    "        b = 0.0",
    "    import math",
    "    op('shot0').par.value0 = math.floor(b)",
    "    return"
   ]
  },
  "spectrum": {
   "type": "selectTOP",
   "family": "TOP",
