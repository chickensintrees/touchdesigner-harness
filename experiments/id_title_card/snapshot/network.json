  "motion": {
   "type": "constantCHOP",
   "family": "CHOP",
   "pos": [
    -400,
    -100
   ],
   "pars": {
    "const0name": "cb",
    "const0value": {
     "expr": "mod('typeset').cycle_beats((op('hub')['bar_pos'] * 4 if op('hub').numChans else absTime.seconds * 2), parent().par.Cycle)"
    },
    "const1name": "total",
    "const1value": {
     "expr": "4 * max(0, parent().par.Cycle)"
    },
    "const2name": "beat",
    "const2value": {
     "expr": "(op('hub')['bar_pos'] * 4 if op('hub').numChans else absTime.seconds * 2) if parent().par.Cycle > 0 else 0"
    },
    "const3name": "m",
    "const3value": {
     "expr": "mod('typeset').motion(mod('typeset').take_name(parent().par.Take), (op('hub')['bar_pos'] * 4 if op('hub').numChans else absTime.seconds * 2), parent().par.Cycle, float(op('runs')[1, 'span']))"
    },
    "const4name": "chars",
    "const4value": {
     "expr": "mod('typeset').typed_chars(mod('typeset').cycle_beats((op('hub')['bar_pos'] * 4 if op('hub').numChans else absTime.seconds * 2), parent().par.Cycle), 4 * max(0, parent().par.Cycle))"
    }
   }
  },
