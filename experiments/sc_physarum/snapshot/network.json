    -370
   ],
   "pars": {
    "language": "text"
   },
   "text": [
    "[{\"name\": \"xray\", \"describe\": [], \"label\": \"SLIME MOULD SIMULATION\\n230,400 agents sniff out the X-ray of a turning\\n3D model and lay trails along it. A kick throws a ring.\"}, {\"name\": \"bleed\", \"describe\": [\"EVERY DRIP IS\\nA TRAIL OF AGENTS.\", \"230,400 AGENTS,\\nALL PULLED DOWNHILL.\", \"DRIPS MERGE WHERE\\nTHEIR TRAILS MEET.\", \"A KICK SENDS MANY\\nBACK TO THE LETTERS.\", \"SLIME MOULD AGENTS\\nWITH A DOWNHILL PULL.\", \"OFF THE PAGE, THEY\\nSTART AGAIN HERE.\"], \"label\": \"\"}, {\"name\": \"marble\", \"describe\": [], \"label\": \"SLIME MOULD SIMULATION\\nNo subject: 230,400 agents follow each other's\\ntrails over faint noise. Bass makes the mesh coarser.\"}, {\"name\": \"toner\", \"describe\": [\"EVERY SPECK IS ONE AGENT. 230,400 OF THEM SNIFF OUT THESE LETTERS AND CROWD ONTO THEM. NO TRAILS ARE DRAWN HERE. A KICK BLOWS THEM LOOSE AND THEY SETTLE BACK.\", \"A SLIME MOULD SIMULATION WITH THE TRAILS SWITCHED OFF. WHAT IS LEFT IS 230,400 GRAINS HUNTING FOR LETTERS. THE SNARE LOOSENS THEM. THE BAR OF LIGHT CROSSES ONCE EVERY BAR.\"], \"label\": \"\"}, {\"name\": \"dishes\", \"describe\": [\"SLIME\\nMOULD\", \"TRAIL\\nMAP\", \"AGENTS\", \"WALLED\\nIN\"], \"label\": \"SLIME MOULD SIMULATION\\nEvery dish is walled: agents cannot cross the glass.\\nEach kick drops some of them back onto the food.\"}, {\"name\": \"blot\", \"describe\": [], \"label\": \"SLIME MOULD SIMULATION, FOLDED\\nOne half of the trail map is shown twice, like an\\ninkblot. Kicks spatter it. A new section, a new blot.\"}, {\"name\": \"sheet\", \"describe\": [\"HOW THIS PICTURE IS MADE\\n\\n1. 230,400 AGENTS START IN FIVE BLOTS.\\n2. EACH ONE SNIFFS THREE POINTS AHEAD.\\n3. IT TURNS TOWARD THE STRONGEST SMELL,\\n    STEPS, AND LEAVES A TRAIL.\\n4. PRINTED INK SMELLS LIKE FOOD,\\n    SO THE MOULD FOLLOWS THESE LINES.\\n5. TRAILS BLUR AND FADE.\"], \"label\": \"\"}, {\"name\": \"onebit\", \"describe\": [\"TRAIL\", \"AGENT\", \"SLIME\", \"MOULD\", \"SNIFF\", \"TURN\", \"STEP\", \"1-BIT\"], \"label\": \"SLIME MOULD SIMULATION\\nTrails of 230,400 agents, cut to pure\\nblack or white by a 4x4 dither.\"}, {\"name\": \"poster\", \"describe\": [], \"label\": \"SLIME MOULD SIMULATION\\n230,400 agents burst out of one small 3D model,\\nthen crawl back to it along its scent.\"}, {\"name\": \"crt\", \"describe\": [\"THIS IS A SLIME MOULD SIMULATION. 230,400 AGENTS EACH SNIFF LEFT, AHEAD AND RIGHT, TURN TOWARD THE STRONGEST SMELL, STEP, AND LEAVE A TRAIL. THIS TEXT IS THE FOOD, SO THE VEINS GATHER ON THE LETTERS.\", \"NOBODY DREW THESE VEINS. 230,400 AGENTS START ON NINE ROWS AND MARCH UP AND DOWN. EACH ONE STEERS TOWARD THE STRONGEST TRAIL. THESE WORDS ARE FOOD. A KICK THROWS RINGS. A SNARE MAKES THE MOULD FLEE.\"], \"label\": \"\"}, {\"name\": \"rust\", \"describe\": [\"SLIME\\nMOULD\", \"TRAIL\\nMAP\", \"230,400\\nAGENTS\"], \"label\": \"SLIME MOULD SIMULATION, 3x CLOSE-UP\\nThe trail map lit as a height field: thick trails\\nread as rust, thin ones as blistered paint.\"}]"
   ]
  },
