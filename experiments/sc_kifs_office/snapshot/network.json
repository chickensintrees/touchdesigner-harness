  "kifs": {
   "type": "glslTOP",
   "family": "TOP",
   "pos": [
    500,
    100
   ],
   "inputs": [
    [
     "wall_sw"
    ],
    [
     "phr_sw"
    ],
    [
     "in_sel"
    ]
   ],
   "pars": {
    "computedat": "kifs_compute",
    "format": "rgba16float",
    "inputextenduv": "repeat",
    "inputfiltertype": "mipmap",
    "outputresolution": "custom",
    "pixeldat": "kifs_frag",
    "resolutionh": 720,
    "resolutionw": 1280,
    "vec0name": "uCam",
    "vec0valuew": {
     "expr": "op('hub')['energy']"
    },
    "vec0valuex": {
     "expr": "op('hub')['evolve']"
    },
    "vec0valuey": {
     "expr": "op('hub')['beat_pos']"
    },
    "vec0valuez": {
     "expr": "op('hub')['section']"
    },
    "vec1name": "uFold",
    "vec1valuew": {
     "expr": "op('hub')['pulse']"
    },
    "vec1valuex": {
     "expr": "0.16 * math.sin(op('tune')['bass_pitch'] * math.pi / 6)"
    },
    "vec1valuey": {
     "expr": "0.11 * math.sin(op('tune')['pitch'] * math.pi / 6)"
    },
    "vec1valuez": {
     "expr": "op('hub')['bar_pulse']"
    },
    "vec2name": "uHit",
    "vec2valuew": {
     "expr": "op('hub')['hit_high']"
    },
    "vec2valuex": {
     "expr": "1 - op('ring')[0]"
    },
    "vec2valuey": {
     "expr": "op('ring')[0]"
    },
    "vec2valuez": {
     "expr": "op('hub')['hit_mid']"
    },
    "vec3name": "uShot",
    "vec3valuew": {
     "expr": "max(0, 1 - op('shot')['age'] / 0.5)"
    },
    "vec3valuex": {
     "expr": "op('shot')['seed']"
    },
    "vec3valuey": {
     "expr": "op('shot')['age']"
    },
    "vec3valuez": {
     "expr": "op('shot')['take']"
    },
    "vec4name": "uTakeA",
    "vec4valuew": {
     "expr": "float(op('takes')[int(op('shot')['take']) % 7 + 1, 'grade'])"
    },
    "vec4valuex": {
     "expr": "float(op('takes')[int(op('shot')['take']) % 7 + 1, 'arch'])"
    },
    "vec4valuey": {
     "expr": "float(op('takes')[int(op('shot')['take']) % 7 + 1, 'cam'])"
    },
    "vec4valuez": {
     "expr": "float(op('takes')[int(op('shot')['take']) % 7 + 1, 'light'])"
    },
    "vec5name": "uTakeB",
    "vec5valuew": {
     "expr": "float(op('takes')[int(op('shot')['take']) % 7 + 1, 'relief'])"
    },
    "vec5valuex": {
     "expr": "float(op('takes')[int(op('shot')['take']) % 7 + 1, 'folda'])"
    },
    "vec5valuey": {
     "expr": "float(op('takes')[int(op('shot')['take']) % 7 + 1, 'foldb'])"
    },
    "vec5valuez": {
     "expr": "float(op('takes')[int(op('shot')['take']) % 7 + 1, 'atlas'])"
    },
    "vec6name": "uTakeC",
    "vec6valuew": {
     "expr": "float(op('takes')[int(op('shot')['take']) % 7 + 1, 'tscale'])"
    },
    "vec6valuex": {
     "expr": "float(op('takes')[int(op('shot')['take']) % 7 + 1, 'speed'])"
    },
    "vec6valuey": {
     "expr": "float(op('takes')[int(op('shot')['take']) % 7 + 1, 'focal'])"
    },
    "vec6valuez": {
     "expr": "float(op('takes')[int(op('shot')['take']) % 7 + 1, 'fog'])"
    },
    "vec7name": "uTakeD",
    "vec7valuew": {
     "expr": "0"
    },
    "vec7valuex": {
     "expr": "float(op('takes')[int(op('shot')['take']) % 7 + 1, 'iters'])"
    },
    "vec7valuey": {
     "expr": "float(op('takes')[int(op('shot')['take']) % 7 + 1, 'shrink'])"
    },
    "vec7valuez": {
     "expr": "0"
    },
    "vec8name": "uIn",
    "vec8valuew": {
     "expr": "0"
    },
    "vec8valuex": {
     "expr": "1 if (lambda p: bool(p) and op(p) is not None and op(p).isTOP and not op(p).path.startswith(parent().path + '/'))(parent().par.Input.eval().strip()) else 0"
    },
    "vec8valuey": {
     "expr": "int(parent().par.Describe)"
    },
    "vec8valuez": {
     "expr": "0"
    }
   }
  },
  "kifs_compute": {
   "type": "textDAT",
   "family": "DAT",
   "pos": [
    320,
    -120
   ],
   "pars": {
    "language": "glsl"
   },
   "text": [
    "// Example Compute Shader",
    "",
    "// uniform float exampleUniform;",
    "",
    "layout (local_size_x = 8, local_size_y = 4) in;",
    "void main()",
    "{",
    "\t// This code is running 1:1 per pixel, so early-exit",
    "\t// if this thread overhangs the edge of the output",
    "\tif (any(greaterThanEqual(ivec2(gl_GlobalInvocationID.xy), ivec2(uTDOutputInfo.res.zw))))",
    "\t\treturn;",
    "",
    "\tvec4 color;",
    "\t//color = texelFetch(sTD2DInputs[0], ivec2(gl_GlobalInvocationID.xy), 0);",
    "\tcolor = vec4(1.0);",
    "\t// We need to use TDImageStoreOutput() so that 8-bit textures that are sRGB",
    "\t// encoded can be written to correctly from incoming linear values.",
    "\t// imageStore() does not do this automatically, while pixel shader outputs do.",
    "\tTDImageStoreOutput(0, gl_GlobalInvocationID, color);",
    "}"
   ]
  },
