    -120
   ],
   "pars": {
    "extension": "frag",
    "language": "glsl"
   },
   "text": [
    "",
    "// Example Pixel Shader",
    "",
    "// uniform float exampleUniform;",
    "",
    "out vec4 fragColor;",
    "void main()",
    "{",
    "\t// vec4 color = texture(sTD2DInputs[0], vUV.st);",
    "\tvec4 color = vec4(1.0);",
    "\tfragColor = TDOutputSwizzle(color);",
    "}"
   ]
