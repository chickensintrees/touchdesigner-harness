  "cam": {
   "type": "cameraCOMP",
   "family": "COMP",
   "pos": [
    500,
    150
   ],
   "pars": {
    "far": 50.0,
    "fov": 50.0,
    "lookat": "/project1/im_depth_relief/target",
    "near": 0.05,
    "tx": {
     "expr": "(parent().par.Distance * op('take')['dist'] * (1 - 0.07 * parent().par.React * (op('hub')['hit_low'] if op('hub').numChans else 0))) * math.sin(math.radians(op('take')['az'] + op('take')['swing'] * parent().par.Drift * math.sin((op('hub')['bar_pos'] if op('hub').numChans else absTime.seconds * 0.4) * math.pi * 0.5))) * math.cos(math.radians(op('take')['el'] + 4 * parent().par.Drift * math.sin(absTime.seconds * 0.071 + 1.3)))"
    },
    "ty": {
     "expr": "(parent().par.Distance * op('take')['dist'] * (1 - 0.07 * parent().par.React * (op('hub')['hit_low'] if op('hub').numChans else 0))) * math.sin(math.radians(op('take')['el'] + 4 * parent().par.Drift * math.sin(absTime.seconds * 0.071 + 1.3)))"
    },
    "tz": {
     "expr": "(parent().par.Distance * op('take')['dist'] * (1 - 0.07 * parent().par.React * (op('hub')['hit_low'] if op('hub').numChans else 0))) * math.cos(math.radians(op('take')['az'] + op('take')['swing'] * parent().par.Drift * math.sin((op('hub')['bar_pos'] if op('hub').numChans else absTime.seconds * 0.4) * math.pi * 0.5))) * math.cos(math.radians(op('take')['el'] + 4 * parent().par.Drift * math.sin(absTime.seconds * 0.071 + 1.3)))"
    }
   }
  },
